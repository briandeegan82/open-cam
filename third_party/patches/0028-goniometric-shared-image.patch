+const GoniometricData *GoniometricData::Create(Image im, Allocator alloc) {
+    CHECK_EQ(1, im.NChannels());
+    CHECK_EQ(im.Resolution().x, im.Resolution().y);
+    GoniometricData *data = alloc.new_object<GoniometricData>(alloc);
+    data->image = std::move(im);
+    // Compute sampling distribution for _GoniometricLight_
+    Array2D<Float> d = data->image.GetSamplingDistribution();
+    data->distrib = PiecewiseConstant2D(d, alloc);
+    for (int y = 0; y < data->image.Resolution().y; ++y)
+        for (int x = 0; x < data->image.Resolution().x; ++x)
+            data->meanY += data->image.GetChannel({x, y}, 0);
+    data->meanY /= data->image.Resolution().x * data->image.Resolution().y;
+
+    imageBytes += data->image.BytesUsed() + data->distrib.BytesUsed();
+    return data;
+}
