 // HenyeyGreenstein Method Definitions
 std::string HGPhaseFunction::ToString() const {
-    return StringPrintf("[ HGPhaseFunction g: %f ]", g);
+    return StringPrintf("[ HGPhaseFunction g: %f table bins: %d ]", g, tabN);
+}
+
+void HGPhaseFunction::SetTable(const std::vector<Float> &th, const std::vector<Float> &v,
+                               Allocator alloc) {
+    if (th.empty() && v.empty())
+        return;
+    if (v.empty() || th.size() != v.size() + 1)
+        ErrorExit("\"phasetheta\" needs exactly one more value than \"phasevalues\" (%d vs %d).",
+                  th.size(), v.size());
+    int n = v.size();
+    if (th[0] != 0 || th[n] != 180)
+        ErrorExit("\"phasetheta\" must run from 0 to 180 degrees.");
+    Float *s = alloc.allocate_object<Float>(n + 1), *val = alloc.allocate_object<Float>(n),
+          *cdf = alloc.allocate_object<Float>(n + 1);
+    std::vector<double> sd(n + 1), acc(n + 1, 0.);
+    for (int i = 0; i <= n; ++i) {
+        double h = std::sin(0.5 * double(th[i]) * Pi / 180);
+        sd[i] = 2 * h * h;  // 1 - cos(theta)
+        s[i] = Float(sd[i]);
+    }
+    for (int i = 0; i < n; ++i) {
+        if (!(th[i + 1] > th[i]))
+            ErrorExit("\"phasetheta\" must be strictly increasing.");
+        if (v[i] < 0)
+            ErrorExit("\"phasevalues\" must be non-negative.");
+        acc[i + 1] = acc[i] + double(v[i]) * (sd[i + 1] - sd[i]);
+    }
+    double sum = acc[n];
+    if (!(sum > 0))
+        ErrorExit("\"phasevalues\" integrate to zero.");
+    for (int i = 0; i < n; ++i)
+        val[i] = Float(v[i] / (2 * Pi * sum));
+    for (int i = 0; i <= n; ++i)
+        cdf[i] = Float(acc[i] / sum);
+    cdf[n] = 1;
+    tabS = s;
+    tabVal = val;
+    tabCdf = cdf;
+    tabN = n;
 }
 
