+// open-cam spectral SPPM: per-pixel, per-bucket accumulators (nBuckets entries each).
+struct SPPMSpectralBuffers {
+    int nBuckets = 0;
+    std::vector<Float> Ld, wLd, tau, wPhi;
+    std::unique_ptr<AtomicFloat[]> Phi;
+    void Init(size_t nPixels, int nb) {
+        nBuckets = nb;
+        Ld.assign(nPixels * nb, 0.f);
+        wLd.assign(nPixels * nb, 0.f);
+        tau.assign(nPixels * nb, 0.f);
+        wPhi.assign(nPixels * nb, 0.f);
+        Phi.reset(new AtomicFloat[nPixels * nb]);
+        for (size_t i = 0; i < nPixels * nb; ++i)
+            Phi[i] = 0.f;
+    }
+};
+
+// Spectrum indexed like the photon pass's wavelengths, re-ordered to a pixel whose
+// hero was rotated by h (SampledWavelengths::RotateHero(h)).
+inline SampledSpectrum RotateSpectrum(const SampledSpectrum &s, int h) {
+    if (h == 0)
+        return s;
+    SampledSpectrum r;
+    for (int i = 0; i < NSpectrumSamples; ++i)
+        r[i] = s[(i + h) % NSpectrumSamples];
+    return r;
+}
