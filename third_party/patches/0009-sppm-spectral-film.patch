+    // open-cam spectral SPPM: overwrite a pixel with its final sensor RGB and per-bucket
+    // radiance so WriteImage() produces the usual RGB + S0.<lambda>nm layout.
+    int NBuckets() const { return nBuckets; }
+    int BucketOf(Float lambda) const { return LambdaToBucket(lambda); }
+    void SetPixelFinal(Point2i p, RGB sensorRGB, const Float *bucketValues) {
+        Pixel &pix = pixels[p];
+        for (int c = 0; c < 3; ++c) {
+            pix.rgbSum[c] = sensorRGB[c];
+            pix.rgbSplat[c] = 0.;
+        }
+        pix.rgbWeightSum = 1.;
+        for (int i = 0; i < nBuckets; ++i) {
+            pix.bucketSums[i] = bucketValues[i];
+            pix.weightSums[i] = 1.;
+            pix.bucketSplats[i] = 0.;
+        }
+    }
