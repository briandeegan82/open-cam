+pstd::optional<LightBounds> GoniometricLight::PeakBounds() const {
+    // open-cam: bounds for the "bvh" light sampler's beam tree: the peak intensity, not the mean, over a cone around the
+    // intensity-weighted beam axis that holds every emitting texel. The mean made the BVH
+    // light sampler pick a beam-peaked lamp far too rarely where its beam dominates
+    // (fireflies). Importance only sets the sampling pmf, so this is unbiased provided it is
+    // nonzero wherever the lamp emits, which both cone forms below guarantee.
+    Point2i res = image.Resolution();
+    auto texelDir = [&](int x, int y) {
+        return EqualAreaSquareToSphere(Point2f((x + 0.5f) / res.x, (y + 0.5f) / res.y));
+    };
+    Float maxY = 0;
+    Vector3f axis(0, 0, 0);
+    for (int y = 0; y < res.y; ++y)
+        for (int x = 0; x < res.x; ++x) {
+            Float v = image.GetChannel({x, y}, 0);
+            maxY = std::max(maxY, v);
+            if (v > 0)
+                axis += v * texelDir(x, y);
+        }
+    Float phi = scale * Iemit->MaxValue() * 4 * Pi * maxY;
+    Point3f p = renderFromLight(Point3f(0, 0, 0));
+    if (LengthSquared(axis) == 0)
+        return LightBounds(Bounds3f(p, p), Vector3f(0, 0, 1), phi, std::cos(Pi),
+                           std::cos(Pi / 2), false);
+    axis = Normalize(axis);
+    Float cosMax = 1;
+    for (int y = 0; y < res.y; ++y)
+        for (int x = 0; x < res.x; ++x)
+            if (image.GetChannel({x, y}, 0) > 0)
+                cosMax = std::min(cosMax, Dot(axis, texelDir(x, y)));
+    // emitting half-angle plus two texel widths for the nearest-texel lookup
+    Float margin = 2 * std::sqrt(4 * Pi / (res.x * res.y));
+    Float thetaMax = std::min<Float>(SafeACos(cosMax) + margin, Pi);
+    // Two valid forms: (a) flat over the emitting cone, zero outside; (b) flat out to
+    // thetaMax - pi/2, then the BVH's cosine falloff. Keep the one with less total
+    // importance over the sphere (solid angle, weighted by the falloff for (b)).
+    Float flatSA = 2 * Pi * (1 - std::cos(thetaMax));
+    Float thetaO = std::max<Float>(thetaMax - Pi / 2, 0);
+    Float cosSA = 2 * Pi * (1 - std::cos(thetaO));
+    constexpr int nSteps = 256;
+    for (int i = 0; i < nSteps; ++i) {
+        Float t = thetaO + (i + 0.5f) * (Pi / 2) / nSteps;
+        if (t < Pi)
+            cosSA += 2 * Pi * std::cos(t - thetaO) * std::sin(t) * (Pi / 2) / nSteps;
+    }
+    Vector3f w = Normalize(renderFromLight(axis));
+    if (flatSA <= cosSA)
+        return LightBounds(Bounds3f(p, p), w, phi, std::cos(thetaMax), std::cos(margin),
+                           false);
+    return LightBounds(Bounds3f(p, p), w, phi, std::cos(thetaO), std::cos(Pi / 2), false);
+}
