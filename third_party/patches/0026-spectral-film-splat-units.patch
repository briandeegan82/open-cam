diff --git a/src/pbrt/film.cpp b/src/pbrt/film.cpp
index 59c016f..ece7a12 100644
--- a/src/pbrt/film.cpp
+++ b/src/pbrt/film.cpp
@@ -925,7 +925,11 @@ PBRT_CPU_GPU void SpectralFilm::AddSplat(Point2f p, SampledSpectrum L,
     Float lm = L.MaxComponentValue();
     if (lm > maxComponentValue)
         L *= maxComponentValue / lm;
-    L = SafeDiv(L, lambda.PDF()) / NSpectrumSamples;
+    // open-cam: AddSample stores the bucket mean of L * CIE_Y_integral, while L / pdf / N
+    // estimates the integral of L over the bucket (width x mean). Divide by the bucket width
+    // and apply CIE_Y_integral so splats and samples are in the same units.
+    L = SafeDiv(L, lambda.PDF()) *
+        (CIE_Y_integral * nBuckets / ((lambdaMax - lambdaMin) * NSpectrumSamples));
 
     // Compute bounds of affected pixels for splat, _splatBounds_
     Point2f pDiscrete = p + Vector2f(0.5, 0.5);
@@ -999,14 +1003,13 @@ Image SpectralFilm::GetImage(ImageMetadata *metadata, Float splatScale) {
         // Set spectral channels. Hardcoded assuming that they come
         // immediately after RGB, as is currently specified above.
         for (int i = 0; i < nBuckets; ++i) {
-            Float c = 0;
-            if (pixel.weightSums[i] > 0) {
-                c = pixel.bucketSums[i] / pixel.weightSums[i] +
-                    splatScale * pixel.bucketSplats[i] / filterIntegral;
-                if (writeFP16 && c > 65504) {
-                    c = 65504;
-                    ++nClamped;
-                }
+            // open-cam: splats count even where no camera sample landed (light tracing).
+            Float c = splatScale * pixel.bucketSplats[i] / filterIntegral;
+            if (pixel.weightSums[i] > 0)
+                c += pixel.bucketSums[i] / pixel.weightSums[i];
+            if (writeFP16 && c > 65504) {
+                c = 65504;
+                ++nClamped;
             }
             image.SetChannel(pOffset, 3 + i, c);
         }
