+    PBRT_CPU_GPU Float SlabReflectance(Float cosTheta,
+                                       const SampledWavelengths &lambda) const {
+        Float e = eta(lambda[0]);
+        if (e == 0)
+            e = 1;
+        Float R = FrDielectric(cosTheta, e), T = 1 - R;
