+// Fluorescent reradiation (open-cam patch). At a FluorescentMaterial hit, with
+// probability p_f the path continues through the reradiation channel: every lane i
+// keeps its film (emission) wavelength lem_i for accumulation, but the rest of the path
+// is traced at a new, uniformly sampled excitation wavelength lex_i, with throughput
+// weight M(lem_i, lex_i) / (pdf(lex_i) p_f) and a unit-albedo Lambertian lobe.
+// Otherwise the ordinary diffuse reflection is used with weight 1 / (1 - p_f).
+// The caller's film wavelengths are restored by FluorescenceLambdaGuard.
+struct FluorescenceLambdaGuard {
+    SampledWavelengths &lambda;
+    SampledWavelengths saved;
+    bool active = false;
+    ~FluorescenceLambdaGuard() {
+        if (!active)
+            return;
+        bool terminated = lambda.SecondaryTerminated();
+        lambda = saved;
+        if (terminated)
+            lambda.TerminateSecondary();
+    }
+};
+
+static void ApplyFluorescence(SurfaceInteraction &isect, BSDF &bsdf,
+                              SampledWavelengths &lambda, SampledSpectrum &beta,
+                              Sampler sampler, ScratchBuffer &scratchBuffer,
+                              FluorescenceLambdaGuard &guard) {
+    if (!isect.material || !isect.material.Is<FluorescentMaterial>())
+        return;
+    const FluorescentMaterial *fm = isect.material.Cast<FluorescentMaterial>();
+    Float pf = fm->FluorescenceProbability();
+    if (sampler.Get1D() >= pf) {
+        beta /= 1 - pf;
+        return;
+    }
+    SampledWavelengths ex = SampledWavelengths::SampleUniform(sampler.Get1D());
+    beta *= fm->Donaldson(lambda, ex) * ((Lambda_max - Lambda_min) / pf);
+    if (lambda.SecondaryTerminated())
+        ex.TerminateSecondary();
+    guard.active = true;
+    lambda = ex;
+    bsdf = BSDF(isect.shading.n, isect.shading.dpdu,
+                scratchBuffer.Alloc<DiffuseBxDF>(SampledSpectrum(1.f)));
+}
