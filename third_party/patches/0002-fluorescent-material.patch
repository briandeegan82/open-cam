+// FluorescentMaterial Method Definitions
+std::string FluorescentMaterial::ToString() const {
+    return StringPrintf("[ FluorescentMaterial displacement: %s normalMap: %s "
+                        "reflectance: %s excitation: %s emission: %s "
+                        "emissionScale: %f probability: %f ]",
+                        displacement,
+                        normalMap ? normalMap->ToString() : std::string("(nullptr)"),
+                        reflectance, excitation, emission, emissionScale, probability);
+}
+
+FluorescentMaterial *FluorescentMaterial::Create(
+    const TextureParameterDictionary &parameters, Image *normalMap, const FileLoc *loc,
+    Allocator alloc) {
+    SpectrumTexture reflectance = parameters.GetSpectrumTexture(
+        "reflectance", nullptr, SpectrumType::Albedo, alloc);
+    if (!reflectance)
+        reflectance = alloc.new_object<SpectrumConstantTexture>(
+            alloc.new_object<ConstantSpectrum>(0.5f));
+    // Quantum yield x absorptance of the fluorophore, as a function of excitation lambda.
+    Spectrum excitation =
+        parameters.GetOneSpectrum("excitation", nullptr, SpectrumType::Unbounded, alloc);
+    // Photon emission spectrum (shape only; normalized to unit area here).
+    Spectrum emission =
+        parameters.GetOneSpectrum("emission", nullptr, SpectrumType::Unbounded, alloc);
+    if (!excitation || !emission)
+        ErrorExit(loc, "\"fluorescent\" material requires \"excitation\" and "
+                       "\"emission\" spectra.");
+    Float area = 0;
+    for (Float l = Lambda_min; l <= Lambda_max; l += 1)
+        area += std::max<Float>(0, emission(l));
+    if (area <= 0)
+        ErrorExit(loc, "\"emission\" spectrum must be positive in [%f, %f] nm.",
+                  Lambda_min, Lambda_max);
+    Float probability = parameters.GetOneFloat("fluorescenceprobability", 0.5f);
+    if (!(probability > 0 && probability < 1))
+        ErrorExit(loc, "\"fluorescenceprobability\" must be in (0, 1).");
+    FloatTexture displacement = parameters.GetFloatTextureOrNull("displacement", alloc);
+    return alloc.new_object<FluorescentMaterial>(reflectance, excitation, emission,
+                                                 1 / area, probability, displacement,
+                                                 normalMap);
+}
