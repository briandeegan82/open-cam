+// open-cam (patch 0035): cone (light space) that holds every direction an angular map emits
+// in: axis = the map's mean direction, cosMax = the widest emitting texel, with a margin of
+// two texels for the bilinear lookup. Cached per map.
+static bool AngularMapCone(const Image *angular, Vector3f *axis, Float *cosMax) {
+    struct Cone {
+        Vector3f axis;
+        Float cosMax;
+        bool valid;
+    };
+    static std::mutex mutex;
+    static std::map<const Image *, Cone> cache;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = cache.find(angular);
+    if (it == cache.end()) {
+        int n = angular->Resolution().x;
+        Vector3f sum(0, 0, 0);
+        for (int y = 0; y < n; ++y)
+            for (int x = 0; x < n; ++x)
+                sum += angular->GetChannel({x, y}, 0) *
+                       EqualAreaSquareToSphere(Point2f((x + 0.5f) / n, (y + 0.5f) / n));
+        Cone cone{Vector3f(0, 0, 1), -1, false};
+        if (LengthSquared(sum) > 0) {
+            cone.axis = Normalize(sum);
+            Float c = 1;
+            for (int y = 0; y < n; ++y)
+                for (int x = 0; x < n; ++x)
+                    if (angular->GetChannel({x, y}, 0) > 0)
+                        c = std::min(c, Dot(cone.axis, EqualAreaSquareToSphere(Point2f(
+                                                           (x + 0.5f) / n, (y + 0.5f) / n))));
+            Float theta = SafeACos(c) + 2 * std::sqrt(4 * Pi) / n;
+            cone.cosMax = theta < Pi ? std::cos(theta) : -1;
+            cone.valid = theta < Pi;
+        }
+        it = cache.emplace(angular, cone).first;
+    }
+    *axis = it->second.axis;
+    *cosMax = it->second.cosMax;
+    return it->second.valid;
+}
