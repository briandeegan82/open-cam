     SampledSpectrum R;
 };
 
+// RetroreflectiveBxDF Definition
+// Lambertian base plus a retroreflective lobe centred on the incident direction,
+// parameterised by the coefficient of retroreflection R_A [cd lx^-1 m^-2]
+// (ASTM E808 / E810, CIE 54.2). With I = R_A E_perp A and L = I / (A cos(theta_o)),
+// the lobe BRDF is f = R_A / (cos(theta_i) cos(theta_o)), where
+//   R_A(alpha, theta_i, theta_o) = ra exp(-(alpha - alpha0) / width) (cos_i cos_o)^(q/2)
+// alpha is the observation angle (between wi and wo), alpha0 the reference observation
+// angle at which ra is specified (normal entrance) and q the entrance-angle exponent.
+// R_L of road markings (EN 1436) maps to q = 0, ra = R_L cos(theta_o).
+class RetroreflectiveBxDF {
+  public:
+    // RetroreflectiveBxDF Public Methods
+    RetroreflectiveBxDF() = default;
+    PBRT_CPU_GPU
+    RetroreflectiveBxDF(SampledSpectrum R, SampledSpectrum ra, Float alpha0, Float width,
+                        Float q)
+        : R(R), ra(ra), alpha0(alpha0), width(width), q(q) {}
+
+    PBRT_CPU_GPU
+    static Float ObservationAngle(Vector3f wo, Vector3f wi) {
+        // Chord form: accurate for the sub-degree angles of retroreflection.
+        return 2 * SafeASin(Length(wo - wi) / 2);
+    }
+
+    // Lobe albedo bound for an effective cosine c (small-angle integral of the lobe),
+    // used to scale the lobe so that the BRDF never reflects more than 1 - max(R).
+    PBRT_CPU_GPU
+    Float EnergyScale(Float c) const {
+        Float peak = ra.MaxComponentValue() * std::exp(alpha0 / width);
+        Float albedo = peak * 2 * Pi * Sqr(width) * std::pow(std::max(c, Float(1e-4)), q - 1);
+        Float budget = std::max<Float>(0, 1 - R.MaxComponentValue());
+        return albedo > budget ? budget / albedo : 1;
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum Lobe(Vector3f wo, Vector3f wi) const {
+        Float ci = CosTheta(wi), co = CosTheta(wo);
+        if (ci <= 0 || co <= 0 || width <= 0 || !ra)
+            return SampledSpectrum(0.f);
+        Float alpha = ObservationAngle(wo, wi);
+        Float c = ci * co;
+        Float g = std::exp(-(alpha - alpha0) / width) * std::pow(c, q / 2 - 1);
+        return ra * (g * EnergyScale(std::sqrt(c)));
+    }
+
+    PBRT_CPU_GPU
+    Float LobeProbability(Vector3f wo) const {
+        if (width <= 0 || !ra || CosTheta(wo) <= 0)
+            return 0;
+        Float co = CosTheta(wo);
+        Float peak = ra.Average() * std::exp(alpha0 / width);
+        Float albedo = peak * 2 * Pi * Sqr(width) * std::pow(co, q - 1) * EnergyScale(co);
+        Float d = R.Average();
+        if (albedo + d <= 0)
+            return 0;
+        if (d <= 0)
+            return 1;
+        // Narrow lobes are found almost only by BSDF sampling; give them a floor.
+        return std::max<Float>(0.25f, albedo / (albedo + d));
+    }
+
+    PBRT_CPU_GPU
+    Float LobePDF(Vector3f wo, Vector3f wi) const {
+        // alpha ~ Gamma(2, width): p(alpha) = alpha e^{-alpha/width} / width^2,
+        // uniform azimuth about wo.
+        Float alpha = ObservationAngle(wo, wi);
+        Float s = std::sin(alpha);
+        if (s <= 0)
+            return 0;
+        return alpha * std::exp(-alpha / width) / (Sqr(width) * 2 * Pi * s);
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum f(Vector3f wo, Vector3f wi, TransportMode mode) const {
+        if (!SameHemisphere(wo, wi))
+            return SampledSpectrum(0.f);
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        return R * InvPi + Lobe(wo, wi);
+    }
+
+    PBRT_CPU_GPU
+    pstd::optional<BSDFSample> Sample_f(
+        Vector3f wo, Float uc, Point2f u, TransportMode mode,
+        BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection))
+            return {};
+        bool flip = wo.z < 0;
+        Vector3f w = flip ? -wo : wo;
+        Float pr = LobeProbability(w);
+        Vector3f wi;
+        if (uc < pr) {
+            Float u0 = std::max<Float>(uc / pr, 1e-7f);
+            Float alpha = -width * std::log(std::max<Float>(u0 * u[0], 1e-12f));
+            if (alpha >= Pi)
+                return {};
+            Float phi = 2 * Pi * u[1];
+            Frame frame = Frame::FromZ(w);
+            wi = frame.FromLocal(SphericalDirection(std::sin(alpha), std::cos(alpha), phi));
+            if (wi.z <= 0)
+                return {};
+        } else {
+            wi = SampleCosineHemisphere(u);
+        }
+        Float pdf = PDF(w, wi, mode, sampleFlags);
+        if (pdf <= 0)
+            return {};
+        SampledSpectrum fv = R * InvPi + Lobe(w, wi);
+        if (flip)
+            wi = -wi;
+        return BSDFSample(fv, wi, pdf, R ? BxDFFlags::DiffuseReflection
+                                         : BxDFFlags::GlossyReflection);
+    }
+
+    PBRT_CPU_GPU
+    Float PDF(Vector3f wo, Vector3f wi, TransportMode mode,
+              BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection) || !SameHemisphere(wo, wi))
+            return 0;
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        Float pr = LobeProbability(wo);
+        return (1 - pr) * CosineHemispherePDF(AbsCosTheta(wi)) +
+               (pr > 0 ? pr * LobePDF(wo, wi) : 0);
+    }
+
+    PBRT_CPU_GPU
+    static constexpr const char *Name() { return "RetroreflectiveBxDF"; }
+
+    std::string ToString() const;
+
+    PBRT_CPU_GPU
+    void Regularize() {}
+
+    PBRT_CPU_GPU
+    BxDFFlags Flags() const {
+        BxDFFlags flags = BxDFFlags::Unset;
+        if (R)
+            flags = flags | BxDFFlags::DiffuseReflection;
+        if (ra && width > 0)
+            flags = flags | BxDFFlags::GlossyReflection;
+        return flags;
+    }
+
+  private:
+    SampledSpectrum R, ra;
+    Float alpha0, width, q;
+};
