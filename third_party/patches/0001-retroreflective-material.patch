+// RetroreflectiveMaterial Method Definitions
+std::string RetroreflectiveMaterial::ToString() const {
+    return StringPrintf("[ RetroreflectiveMaterial displacement: %s normalMap: %s "
+                        "reflectance: %s ra: %s alpha0: %f width: %f q: %f ]",
+                        displacement,
+                        normalMap ? normalMap->ToString() : std::string("(nullptr)"),
+                        reflectance, ra, alpha0, width, q);
+}
+
+RetroreflectiveMaterial *RetroreflectiveMaterial::Create(
+    const TextureParameterDictionary &parameters, Image *normalMap, const FileLoc *loc,
+    Allocator alloc) {
+    SpectrumTexture reflectance = parameters.GetSpectrumTexture(
+        "reflectance", nullptr, SpectrumType::Albedo, alloc);
+    if (!reflectance)
+        reflectance = alloc.new_object<SpectrumConstantTexture>(
+            alloc.new_object<ConstantSpectrum>(0.f));
+    // Coefficient of retroreflection [cd lx^-1 m^-2] at "observationangle", normal entrance.
+    SpectrumTexture ra =
+        parameters.GetSpectrumTexture("ra", nullptr, SpectrumType::Unbounded, alloc);
+    if (!ra)
+        ra = alloc.new_object<SpectrumConstantTexture>(
+            alloc.new_object<ConstantSpectrum>(0.f));
+    Float alpha0 = Radians(parameters.GetOneFloat("observationangle", 0.2f));
+    Float width = Radians(parameters.GetOneFloat("lobewidth", 0.31f));
+    Float q = parameters.GetOneFloat("entranceexponent", 2.7f);
+    if (width <= 0)
+        ErrorExit(loc, "\"lobewidth\" must be positive.");
+    FloatTexture displacement = parameters.GetFloatTextureOrNull("displacement", alloc);
+    return alloc.new_object<RetroreflectiveMaterial>(reflectance, ra, alpha0, width, q,
+                                                     displacement, normalMap);
+}
