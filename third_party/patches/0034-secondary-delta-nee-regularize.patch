--- a/src/pbrt/bsdf.h
+++ b/src/pbrt/bsdf.h
@@ -145,6 +145,24 @@
     PBRT_CPU_GPU
     void Regularize() { bxdf.Regularize(); }
 
+    // Evaluate f() on a stack copy of the BxDF after Regularize(), leaving
+    // this BSDF unchanged. Used for secondary-bounce NEE to delta lights
+    // (open-cam patch 0034) so glossy-to-point-light spikes are capped
+    // without blurring the continuation BSDF sample.
+    PBRT_CPU_GPU
+    SampledSpectrum fRegularized(Vector3f woRender, Vector3f wiRender,
+                                 TransportMode mode = TransportMode::Radiance) const {
+        Vector3f wi = RenderToLocal(wiRender), wo = RenderToLocal(woRender);
+        if (wo.z == 0)
+            return {};
+        auto eval = [&](auto ptr) -> SampledSpectrum {
+            auto copy = *ptr;
+            copy.Regularize();
+            return copy.f(wo, wi, mode);
+        };
+        return bxdf.Dispatch(eval);
+    }
+
   private:
     // BSDF Private Members
     BxDF bxdf;
