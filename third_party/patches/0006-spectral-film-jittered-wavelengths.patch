diff --git a/src/pbrt/util/spectrum.h b/src/pbrt/util/spectrum.h
--- a/src/pbrt/util/spectrum.h
+++ b/src/pbrt/util/spectrum.h
@@ -285,6 +285,26 @@
 
     std::string ToString() const;
 
+    // open-cam: one wavelength per stratum of width (max - min) / NSpectrumSamples, each
+    // jittered independently (SampleUniform shifts all strata by the same offset, so film
+    // buckets one stratum apart receive identical paths). Every lambda[i] is still uniform.
+    PBRT_CPU_GPU
+    static SampledWavelengths SampleUniformJittered(Float u, Float lambda_min,
+                                                    Float lambda_max) {
+        SampledWavelengths swl;
+        Float delta = (lambda_max - lambda_min) / NSpectrumSamples;
+        Float us = u * NSpectrumSamples;
+        int s0 = std::min<int>(int(us), NSpectrumSamples - 1);
+        uint64_t bits = uint64_t(FloatToBits(u)) * 0x9e3779b97f4a7c15ull;
+        for (int i = 0; i < NSpectrumSamples; ++i) {
+            Float v = i == 0 ? us - s0 : Float(MixBits(bits + i) >> 40) * 0x1p-24f;
+            v = std::min<Float>(v, OneMinusEpsilon);
+            swl.lambda[i] = lambda_min + ((s0 + i) % NSpectrumSamples + v) * delta;
+            swl.pdf[i] = 1 / (lambda_max - lambda_min);
+        }
+        return swl;
+    }
+
     PBRT_CPU_GPU
     static SampledWavelengths SampleUniform(Float u, Float lambda_min = Lambda_min,
                                             Float lambda_max = Lambda_max) {
