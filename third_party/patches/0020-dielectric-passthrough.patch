+// open-cam: thin-dielectric or dielectric surface with "bool passthrough" (see
+// ThinDielectricMaterial, DielectricMaterial). Returns false for any other surface;
+// otherwise *R is its reflectance at cosTheta (slab or single interface).
+static bool PassthroughSurface(Material m, Float cosTheta, const SampledWavelengths &lambda,
+                               Float *R) {
+    if (!m)
+        return false;
+    if (m.Is<ThinDielectricMaterial>()) {
+        const ThinDielectricMaterial *t = m.Cast<ThinDielectricMaterial>();
+        if (!t->Passthrough())
+            return false;
+        *R = t->SlabReflectance(cosTheta, lambda);
+        return true;
+    }
+    if (m.Is<DielectricMaterial>()) {
+        const DielectricMaterial *d = m.Cast<DielectricMaterial>();
+        if (!d->Passthrough())
+            return false;
+        *R = d->InterfaceReflectance(cosTheta, lambda);
+        return true;
+    }
+    return false;
 }
 
 
