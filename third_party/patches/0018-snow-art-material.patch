diff --git a/src/pbrt/bxdfs.h b/src/pbrt/bxdfs.h
index 3cb0cb9..e6affbc 100644
--- a/src/pbrt/bxdfs.h
+++ b/src/pbrt/bxdfs.h
@@ -244,6 +244,76 @@ class RoadRTableBxDF {
 // alpha is the observation angle (between wi and wo), alpha0 the reference observation
 // angle at which ra is specified (normal entrance) and q the entrance-angle exponent.
 // R_L of road markings (EN 1436) maps to q = 0, ra = R_L cos(theta_o).
+// Snow reflection function of asymptotic radiative transfer (Kokhanovsky & Zege 2004;
+// R0 of Kokhanovsky et al. 2005): R = R0 rs^x, x = u(mu0) u(mu) / R0, u(mu) = 3/7 (1 + 2 mu),
+// R0 = [A + B (mu + mu0) + C mu mu0 + p(theta)] / [4 (mu + mu0)], p(theta) = 11.1 exp(-0.087 theta)
+// + 1.1 exp(-0.014 theta) (theta in degrees, the scattering angle). rs: spherical albedo.
+class SnowBxDF {
+  public:
+    SnowBxDF() = default;
+    PBRT_CPU_GPU
+    SnowBxDF(SampledSpectrum rs) : rs(rs) {}
+
+    PBRT_CPU_GPU
+    static Float R0(Float mu0, Float mu, Float cosScatter) {
+        Float theta = Degrees(SafeACos(cosScatter));
+        Float p = 11.1f * std::exp(-0.087f * theta) + 1.1f * std::exp(-0.014f * theta);
+        return (1.247f + 1.186f * (mu + mu0) + 5.157f * mu * mu0 + p) / (4 * (mu + mu0));
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum f(Vector3f wo, Vector3f wi, TransportMode mode) const {
+        if (!SameHemisphere(wo, wi))
+            return SampledSpectrum(0.f);
+        Float mu0 = AbsCosTheta(wi), mu = AbsCosTheta(wo);
+        if (mu0 <= 0 || mu <= 0)
+            return SampledSpectrum(0.f);
+        Float r0 = R0(mu0, mu, -Dot(wi, wo));
+        Float x = Sqr(3.f / 7.f) * (1 + 2 * mu0) * (1 + 2 * mu) / r0;
+        SampledSpectrum R;
+        for (int i = 0; i < NSpectrumSamples; ++i)
+            R[i] = rs[i] > 0 ? r0 * std::pow(rs[i], x) : 0;
+        return R * InvPi;
+    }
+
+    PBRT_CPU_GPU
+    pstd::optional<BSDFSample> Sample_f(
+        Vector3f wo, Float uc, Point2f u, TransportMode mode,
+        BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection))
+            return {};
+        Vector3f wi = SampleCosineHemisphere(u);
+        if (wo.z < 0)
+            wi.z *= -1;
+        Float pdf = CosineHemispherePDF(AbsCosTheta(wi));
+        if (pdf <= 0)
+            return {};
+        return BSDFSample(f(wo, wi, mode), wi, pdf, BxDFFlags::DiffuseReflection);
+    }
+
+    PBRT_CPU_GPU
+    Float PDF(Vector3f wo, Vector3f wi, TransportMode mode,
+              BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection) || !SameHemisphere(wo, wi))
+            return 0;
+        return CosineHemispherePDF(AbsCosTheta(wi));
+    }
+
+    PBRT_CPU_GPU
+    static constexpr const char *Name() { return "SnowBxDF"; }
+
+    std::string ToString() const;
+
+    PBRT_CPU_GPU
+    void Regularize() {}
+
+    PBRT_CPU_GPU
+    BxDFFlags Flags() const { return rs ? BxDFFlags::DiffuseReflection : BxDFFlags::Unset; }
+
+  private:
+    SampledSpectrum rs;
+};
