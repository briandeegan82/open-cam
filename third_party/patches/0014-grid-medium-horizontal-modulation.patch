+void GridMedium::SetHorizontalModulation(const std::vector<Float> &v, int nx, int nz,
+                                         Point2f p0, Point2f p1, Allocator alloc) {
+    if (v.empty())
+        return;
+    if (nx < 2 || nz < 2 || int(v.size()) != nx * nz)
+        ErrorExit("\"modulation\" needs modnx * modnz = %d x %d values, got %d.", nx, nz,
+                  v.size());
+    if (!(p1.x > p0.x) || !(p1.y > p0.y))
+        ErrorExit("\"modp1\" must exceed \"modp0\" in both coordinates.");
+    Float *m = alloc.allocate_object<Float>(v.size());
+    for (size_t i = 0; i < v.size(); ++i) {
+        if (!(v[i] >= 0 && v[i] <= 1))
+            ErrorExit("\"modulation\" values must lie in [0, 1] (the density majorant assumes it).");
+        m[i] = v[i];
+    }
+    modVals = m;
+    modNx = nx;
+    modNz = nz;
+    modX0 = p0.x;
+    modX1 = p1.x;
+    modZ0 = p0.y;
+    modZ1 = p1.y;
+}
