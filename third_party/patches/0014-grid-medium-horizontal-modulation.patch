+    PBRT_CPU_GPU
+    Float Modulation(Point3f p) const {
+        if (!modVals)
+            return 1;
+        Float fx = Clamp((p.x - modX0) / (modX1 - modX0) * (modNx - 1), 0, modNx - 1);
+        Float fz = Clamp((p.z - modZ0) / (modZ1 - modZ0) * (modNz - 1), 0, modNz - 1);
+        int ix = std::min<int>(int(fx), modNx - 2), iz = std::min<int>(int(fz), modNz - 2);
+        Float tx = fx - ix, tz = fz - iz;
+        const Float *r0 = modVals + iz * modNx + ix, *r1 = r0 + modNx;
+        return (1 - tz) * ((1 - tx) * r0[0] + tx * r0[1]) + tz * ((1 - tx) * r1[0] + tx * r1[1]);
+    }
