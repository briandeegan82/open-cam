+// open-cam: angular emission maps are shared by every DiffuseAreaLight of a mesh (one light
+// per triangle/patch), so each file is read once.
+static const Image *DiffuseAreaLightAngularMap(const std::string &filename,
+                                               const FileLoc *loc, Allocator alloc) {
+    static std::mutex mutex;
+    static std::map<std::string, const Image *> cache;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = cache.find(filename);
+    if (it != cache.end())
+        return it->second;
+    ImageAndMetadata im = Image::Read(filename, alloc);
+    if (im.image.Resolution().x != im.image.Resolution().y)
+        ErrorExit(loc, "%s: angular map must be a square equal-area image.", filename);
+    ImageChannelDesc yDesc = im.image.GetChannelDesc({"Y"});
+    if (!yDesc)
+        ErrorExit(loc, "%s: angular map must have a \"Y\" channel.", filename);
+    if (im.image.HasAnyInfinitePixels() || im.image.HasAnyNaNPixels())
+        ErrorExit(loc, "%s: angular map has non-finite values.", filename);
+    Image *y = alloc.new_object<Image>(im.image.SelectChannels(yDesc, alloc));
+    Float maxValue = 0;
+    for (int py = 0; py < y->Resolution().y; ++py)
+        for (int px = 0; px < y->Resolution().x; ++px)
+            maxValue = std::max(maxValue, y->GetChannel({px, py}, 0));
+    if (maxValue > 1)
+        Warning(loc, "%s: angular map exceeds 1 (%f); light bounds will be too small.",
+                filename, maxValue);
+    cache[filename] = y;
+    return y;
+}
