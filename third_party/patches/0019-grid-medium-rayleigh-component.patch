+void GridMedium::SetRayleighComponent(const std::vector<Float> &dr, Spectrum sigma_r, int nx,
+                                      int ny, int nz, Allocator alloc) {
+    if (dr.empty())
+        return;
+    if (int(dr.size()) != nx * ny * nz)
+        ErrorExit("\"rayleighdensity\" needs nx*ny*nz = %d values, got %d.", nx * ny * nz,
+                  dr.size());
+    if (!sigma_r)
+        ErrorExit("\"rayleighdensity\" needs \"spectrum sigma_rayleigh\".");
+    for (Float v : dr)
+        if (!(v >= 0))
+            ErrorExit("\"rayleighdensity\" values must be >= 0.");
+    rayleighGrid = alloc.new_object<SampledGrid<Float>>(dr, nx, ny, nz, alloc);
+    sigma_r_spec = alloc.new_object<DenselySampledSpectrum>(sigma_r, alloc);
+    sigR550 = (*sigma_r_spec)(550.f);
+    sigS550 = sigma_s_spec(550.f);
+    rayleighPhases = alloc.allocate_object<HGPhaseFunction>(NRayleighPhases);
+    for (int i = 0; i < NRayleighPhases; ++i) {
+        new (&rayleighPhases[i]) HGPhaseFunction(phase);
+        rayleighPhases[i].SetRayleighFraction(Float(i) / (NRayleighPhases - 1));
+    }
+    for (int z = 0; z < majorantGrid.res.z; ++z)
+        for (int y = 0; y < majorantGrid.res.y; ++y)
+            for (int x = 0; x < majorantGrid.res.x; ++x) {
+                Bounds3f vb = majorantGrid.VoxelBounds(x, y, z);
+                majorantGrid.Set(x, y, z,
+                                 std::max(majorantGrid.Lookup(x, y, z), rayleighGrid->MaxValue(vb)));
+            }
+}
