+        return RoadRTableBxDF(table, ClampZero(texEval(tint, ctx, lambda)), alpha0, alpha1);
+    }
+
+  private:
+    // RoadRTableMaterial Private Members
+    Image *normalMap;
+    FloatTexture displacement;
+    SpectrumTexture tint;
+    const RoadRTable *table;
+    Float alpha0, alpha1;
+};
