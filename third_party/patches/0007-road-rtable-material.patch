+}
+
+RoadRTableMaterial *RoadRTableMaterial::Create(const TextureParameterDictionary &parameters,
+                                               Image *normalMap, const FileLoc *loc,
+                                               Allocator alloc) {
+    // Reduced luminance coefficients r [cd m^-2 lx^-1] = value * rscale (tables: 1e-4).
+    std::vector<Float> tg = parameters.GetFloatArray("tangamma");
+    std::vector<Float> bd = parameters.GetFloatArray("beta");
+    std::vector<Float> rv = parameters.GetFloatArray("r");
+    Float scale = parameters.GetOneFloat("rscale", 1e-4f);
+    if (tg.size() < 2 || bd.size() < 2)
+        ErrorExit(loc, "\"tangamma\" and \"beta\" need at least two values each.");
+    if (rv.size() != tg.size() * bd.size())
+        ErrorExit(loc, "\"r\" needs %d values (tangamma x beta, row-major), got %d.",
+                  int(tg.size() * bd.size()), int(rv.size()));
+    if (tg[0] < 0 || bd[0] < 0 || bd.back() > 180)
+        ErrorExit(loc, "need tangamma >= 0 and 0 <= beta <= 180 degrees.");
+    for (size_t k = 1; k < tg.size(); ++k)
+        if (!(tg[k] > tg[k - 1]))
+            ErrorExit(loc, "\"tangamma\" must be strictly increasing.");
+    for (size_t k = 1; k < bd.size(); ++k)
+        if (!(bd[k] > bd[k - 1]))
+            ErrorExit(loc, "\"beta\" must be strictly increasing.");
+    for (Float v : rv)
+        if (v < 0)
+            ErrorExit(loc, "\"r\" values must be non-negative.");
+    Float *t = alloc.allocate_object<Float>(tg.size());
+    Float *b = alloc.allocate_object<Float>(bd.size());
+    Float *r = alloc.allocate_object<Float>(rv.size());
+    for (size_t k = 0; k < tg.size(); ++k)
+        t[k] = tg[k];
+    for (size_t k = 0; k < bd.size(); ++k)
+        b[k] = Radians(bd[k]);
+    for (size_t k = 0; k < rv.size(); ++k)
+        r[k] = rv[k] * scale;
+    RoadRTable *table = alloc.new_object<RoadRTable>();
+    table->nTan = int(tg.size());
+    table->nBeta = int(bd.size());
+    table->tanGamma = t;
+    table->beta = b;
+    table->r = r;
+    // Q0: mean q over the table's incidence solid angle (all beta), midpoint rule.
+    const int ng = 512, nb = 180;
+    Float gmax = std::atan(tg.back()), num = 0, den = 0;
+    for (int i = 0; i < ng; ++i) {
+        Float g = (i + 0.5f) / ng * gmax, w = std::sin(g);
+        for (int j = 0; j < nb; ++j)
+            num += w * table->Q(std::tan(g), (j + 0.5f) / nb * Pi);
+        den += w * nb;
+    }
+    table->q0 = num / den;
+    // Importance-sampling table: q cos(gamma) sin(gamma) on a (gamma, beta) grid.
+    const int nsg = 256, nsb = 90;
+    std::vector<Float> func(nsg * nsb);
+    for (int j = 0; j < nsb; ++j)
+        for (int i = 0; i < nsg; ++i) {
+            Float g = (i + 0.5f) / nsg * (Pi / 2);
+            func[j * nsg + i] =
+                table->Q(std::tan(g), (j + 0.5f) / nsb * Pi) * std::cos(g) * std::sin(g);
+        }
+    table->distrib = alloc.new_object<PiecewiseConstant2D>(
+        pstd::span<const Float>(func.data(), func.size()), nsg, nsb,
+        Bounds2f(Point2f(0, 0), Point2f(Pi / 2, Pi)), alloc);
+    table->albedo = 2 * table->distrib->Integral();
+    Float alpha0 = Radians(parameters.GetOneFloat("observationmin", 1.5f));
+    Float alpha1 = Radians(parameters.GetOneFloat("observationmax", 15.f));
+    SpectrumTexture tint =
+        parameters.GetSpectrumTexture("tint", nullptr, SpectrumType::Unbounded, alloc);
+    if (!tint)
+        tint = alloc.new_object<SpectrumConstantTexture>(alloc.new_object<ConstantSpectrum>(1.f));
+    FloatTexture displacement = parameters.GetFloatTextureOrNull("displacement", alloc);
+    return alloc.new_object<RoadRTableMaterial>(tint, table, alpha0, alpha1, displacement,
+                                                normalMap);
+}
