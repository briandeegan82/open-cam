+// RoadRTableBxDF Definition
+// Road-surface reflection from a reduced luminance coefficient table r(tan gamma, beta)
+// (CIE 30.2 / CIE 144 r-tables). q = L / E_h = r / cos^3(gamma) is the BRDF for an observer
+// about 1 deg above the surface; gamma is the incidence angle from the normal and
+// beta = pi - |phi_i - phi_o| (beta = 0: light beyond the point, facing the observer).
+// r-tables are only defined for that grazing observation angle, so for observer elevations
+// above alpha0 the BRDF blends (smoothstep to alpha1) into a Lambertian lobe with the
+// table's average luminance coefficient Q0. tan gamma beyond the table is clamped.
+// Sampling: tabulated q cos(gamma) over (gamma, beta) (the lobe peaks at grazing incidence,
+// beyond the point), mixed with cosine sampling for the Q0 lobe and as a floor.
+struct RoadRTable {
+    int nTan = 0, nBeta = 0;
+    const Float *tanGamma = nullptr, *beta = nullptr, *r = nullptr;  // beta [rad]; r [tan][beta]
+    Float q0 = 0;
+    const PiecewiseConstant2D *distrib = nullptr;  // q cos sin over [0, pi/2] x [0, pi]
+    Float albedo = 0;                              // integral of q cos over the hemisphere
+
+    PBRT_CPU_GPU
+    Float Q(Float t, Float b) const {
+        t = Clamp(t, tanGamma[0], tanGamma[nTan - 1]);
+        b = Clamp(b, beta[0], beta[nBeta - 1]);
+        size_t i = FindInterval(nTan, [&](size_t k) { return tanGamma[k] <= t; });
+        size_t j = FindInterval(nBeta, [&](size_t k) { return beta[k] <= b; });
+        Float ft = Clamp((t - tanGamma[i]) / (tanGamma[i + 1] - tanGamma[i]), 0, 1);
+        Float fb = Clamp((b - beta[j]) / (beta[j + 1] - beta[j]), 0, 1);
+        const Float *r0 = r + i * nBeta, *r1 = r0 + nBeta;
+        Float rv = Lerp(ft, Lerp(fb, r0[j], r0[j + 1]), Lerp(fb, r1[j], r1[j + 1]));
+        Float c2 = 1 + t * t;
+        return rv * c2 * std::sqrt(c2);
+    }
+};
+
+class RoadRTableBxDF {
+  public:
+    // RoadRTableBxDF Public Methods
+    RoadRTableBxDF() = default;
+    PBRT_CPU_GPU
+    RoadRTableBxDF(const RoadRTable *table, SampledSpectrum tint, Float alpha0, Float alpha1)
+        : table(table), tint(tint), alpha0(alpha0), alpha1(alpha1) {}
+
+    PBRT_CPU_GPU
+    static Float Beta(Vector3f wo, Vector3f wi) {
+        Float li = std::sqrt(Sqr(wi.x) + Sqr(wi.y)), lo = std::sqrt(Sqr(wo.x) + Sqr(wo.y));
+        Float cosPhi = (li > 0 && lo > 0) ? (wi.x * wo.x + wi.y * wo.y) / (li * lo) : -1;
+        return Pi - SafeACos(cosPhi);
+    }
+
+    PBRT_CPU_GPU
+    Float Blend(Vector3f wo) const { return SmoothStep(SafeASin(CosTheta(wo)), alpha0, alpha1); }
+
+    PBRT_CPU_GPU
+    Float Q(Vector3f wo, Vector3f wi) const {
+        Float ci = CosTheta(wi), so = CosTheta(wo);
+        if (ci <= 0 || so <= 0 || !table)
+            return 0;
+        Float w = Blend(wo);
+        Float qt = 0;
+        if (w < 1)
+            qt = table->Q(SafeSqrt(1 - ci * ci) / ci, Beta(wo, wi));
+        return (1 - w) * qt + w * table->q0;
+    }
+
+    // Probability of sampling the tabulated lobe (wo in the upper hemisphere).
+    PBRT_CPU_GPU
+    Float TableProb(Vector3f wo) const {
+        if (!table || !table->distrib)
+            return 0;
+        Float w = Blend(wo), at = (1 - w) * table->albedo, al = w * table->q0 * Pi;
+        return (at + al > 0) ? 0.9f * at / (at + al) : 0;
+    }
+
+    PBRT_CPU_GPU
+    Float TablePDF(Vector3f wo, Vector3f wi) const {
+        Float ci = CosTheta(wi), si = SinTheta(wi);
+        if (ci <= 0 || si < 1e-6f)
+            return 0;
+        return table->distrib->PDF(Point2f(SafeACos(ci), Beta(wo, wi))) / (2 * si);
+    }
+
+    PBRT_CPU_GPU
+    Float MixPDF(Vector3f wo, Vector3f wi) const {
+        Float pt = TableProb(wo);
+        return pt * (pt > 0 ? TablePDF(wo, wi) : 0) +
+               (1 - pt) * CosineHemispherePDF(AbsCosTheta(wi));
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum f(Vector3f wo, Vector3f wi, TransportMode mode) const {
+        if (!SameHemisphere(wo, wi))
+            return SampledSpectrum(0.f);
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        return tint * Q(wo, wi);
+    }
+
+    PBRT_CPU_GPU
+    pstd::optional<BSDFSample> Sample_f(
+        Vector3f wo, Float uc, Point2f u, TransportMode mode,
+        BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection))
+            return {};
+        bool flip = wo.z < 0;
+        Vector3f wou = flip ? -wo : wo, wi;
+        Float pt = TableProb(wou);
+        if (uc < pt) {
+            Point2f gb = table->distrib->Sample(u);
+            Float sgn = (uc / pt < 0.5f) ? 1 : -1;
+            Float phi = std::atan2(wou.y, wou.x) + sgn * (Pi - gb[1]);
+            Float st = std::sin(gb[0]);
+            wi = Vector3f(st * std::cos(phi), st * std::sin(phi), std::cos(gb[0]));
+        } else
+            wi = SampleCosineHemisphere(u);
+        Float pdf = MixPDF(wou, wi);
+        if (pdf <= 0 || wi.z <= 0)
+            return {};
+        if (flip)
+            wi = -wi;
+        return BSDFSample(f(wo, wi, mode), wi, pdf, BxDFFlags::DiffuseReflection);
+    }
+
+    PBRT_CPU_GPU
+    Float PDF(Vector3f wo, Vector3f wi, TransportMode mode,
+              BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection) || !SameHemisphere(wo, wi))
+            return 0;
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        return MixPDF(wo, wi);
+    }
+
+    PBRT_CPU_GPU
+    static constexpr const char *Name() { return "RoadRTableBxDF"; }
+
+    std::string ToString() const;
+
+    PBRT_CPU_GPU
+    void Regularize() {}
+
+    PBRT_CPU_GPU
+    BxDFFlags Flags() const {
+        return (tint && table) ? BxDFFlags::DiffuseReflection : BxDFFlags::Unset;
+    }
+
+  private:
+    const RoadRTable *table = nullptr;
+    SampledSpectrum tint;
+    Float alpha0 = 0, alpha1 = 0;
+};
