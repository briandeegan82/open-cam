+void ImageInfiniteLight::SetGuidePortals(const std::vector<Point3f> &pts, Float fraction) {
+    if (pts.empty())
+        return;
+    if (pts.size() % 4 != 0 || pts.size() / 4 > MaxGuidePortals)
+        ErrorExit("\"guideportals\": expected 4 points per portal, at most %d portals, "
+                  "got %d points",
+                  MaxGuidePortals, int(pts.size()));
+    if (!(fraction > 0 && fraction < 1))
+        ErrorExit("\"guidefraction\" must be in (0, 1), got %f", fraction);
+    nGuide = int(pts.size() / 4);
+    guideFraction = fraction;
+    for (int i = 0; i < nGuide; ++i) {
+        const Point3f *q = &pts[4 * i];
+        GuidePortal &g = guide[i];
+        g.p0 = q[0];
+        g.e1 = q[1] - q[0];
+        g.e2 = q[3] - q[0];
+        Vector3f c = Cross(g.e1, g.e2);
+        g.area = Length(c);
+        if (g.area == 0 || std::abs(Dot(Normalize(g.e1), Normalize(g.e2))) > 1e-3f ||
+            Length(q[2] - (q[1] + g.e2)) > 1e-3f * std::sqrt(g.area))
+            ErrorExit("\"guideportals\": portal %d is not a rectangle p0 p1 p2 p3", i);
+        g.n = c / g.area;
+    }
 }
 
