+    // open-cam: guide portals are world-space rectangles p0..p3 (render space after
+    // transform); Cross(p1 - p0, p3 - p0) must point out of the enclosure (to the sky).
+    void SetGuidePortals(const std::vector<Point3f> &pts, Float fraction);
+
     pstd::optional<LightBounds> Bounds() const { return {}; }
 
   private:
+    struct GuidePortal {
+        Point3f p0;
+        Vector3f e1, e2, n;
+        Float area;
+    };
+    static constexpr int MaxGuidePortals = 4;
+
+    // Active for points behind the portal whose projection lies within it (5 % margin).
+    PBRT_CPU_GPU
+    bool GuideActive(int i, Point3f p) const {
+        const GuidePortal &g = guide[i];
+        Vector3f d = p - g.p0;
+        if (Dot(d, g.n) >= 0)
+            return false;
+        Float s1 = Dot(d, g.e1) / LengthSquared(g.e1), s2 = Dot(d, g.e2) / LengthSquared(g.e2);
+        return s1 > -0.05f && s1 < 1.05f && s2 > -0.05f && s2 < 1.05f;
+    }
+    PBRT_CPU_GPU
+    int NumGuideActive(Point3f p) const {
+        int n = 0;
+        for (int i = 0; i < nGuide; ++i)
+            n += GuideActive(i, p);
+        return n;
+    }
+    PBRT_CPU_GPU
+    int ActiveGuide(Point3f p, int k) const {
+        for (int i = 0; i < nGuide; ++i)
+            if (GuideActive(i, p) && k-- == 0)
+                return i;
+        return 0;
+    }
+    // Solid-angle density of uniform area sampling over the active portals.
+    PBRT_CPU_GPU
+    Float GuidePDF(Point3f p, Vector3f w, int nActive) const {
+        Float pdf = 0;
+        for (int i = 0; i < nGuide; ++i) {
+            if (!GuideActive(i, p))
+                continue;
+            const GuidePortal &g = guide[i];
+            Float dn = Dot(w, g.n);
+            if (dn <= 0)
+                continue;
+            Float t = Dot(g.p0 - p, g.n) / dn;
+            if (t <= 0)
+                continue;
+            Vector3f d = (p + t * w) - g.p0;
+            Float s1 = Dot(d, g.e1) / LengthSquared(g.e1);
+            Float s2 = Dot(d, g.e2) / LengthSquared(g.e2);
+            if (s1 >= 0 && s1 <= 1 && s2 >= 0 && s2 <= 1)
+                pdf += t * t / (g.area * dn);
+        }
+        return pdf / nActive;
+    }
