+    // open-cam: as SampleUniformJittered, but each stratum is mapped through the CDF of a
+    // tabulated distribution over the film range (spectral film "float bucketweights").
+    template <typename Distrib>
+    PBRT_CPU_GPU static SampledWavelengths SampleTabulatedJittered(Float u, const Distrib &d) {
+        SampledWavelengths swl;
+        Float us = u * NSpectrumSamples;
+        int s0 = std::min<int>(int(us), NSpectrumSamples - 1);
+        uint64_t bits = uint64_t(FloatToBits(u)) * 0x9e3779b97f4a7c15ull;
+        for (int i = 0; i < NSpectrumSamples; ++i) {
+            Float v = i == 0 ? us - s0 : Float(MixBits(bits + i) >> 40) * 0x1p-24f;
+            v = std::min<Float>(v, OneMinusEpsilon);
+            Float uc = std::min<Float>(((s0 + i) % NSpectrumSamples + v) / NSpectrumSamples,
+                                       OneMinusEpsilon);
+            Float pdf = 0;
+            swl.lambda[i] = d.Sample(uc, &pdf);
+            swl.pdf[i] = pdf;
+        }
+        return swl;
+    }
