+        // open-cam glass dispersion: eta(lambda) = eta + dispersionScale *
+        // (nS(lambda) - nS(587.5618 nm)), nS the Sellmeier index (B, C in um^2).
+        Float dispersionScale = 0;
+        Float sellmeierB[3] = {0, 0, 0};
+        Float sellmeierC[3] = {0, 0, 0};
+        PBRT_CPU_GPU Float Sellmeier(Float lambda) const {
+            Float l2 = Sqr(lambda * Float(1e-3)), n2 = 1;
